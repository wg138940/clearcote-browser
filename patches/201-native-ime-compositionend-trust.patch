 }
 
+TEST_F(InputMethodControllerTest, NativeCompositionEndIsTrusted) {
+  GetDocument().GetSettings()->SetScriptEnabled(true);
+  for (const char* html : {"<input id='sample'>",
+                           "<div id='sample' contenteditable></div>"}) {
+    for (int mode = 0; mode < 3; ++mode) {
+      SCOPED_TRACE(html);
+      SCOPED_TRACE(mode);
+      // Replace the fixture so repeated ids cannot select an earlier control.
+      SetBodyContent(html);
+      Element* editable = GetElementById("sample");
+      Element* script = GetDocument().CreateRawElement(html_names::kScriptTag);
+      script->SetInnerHTMLWithoutTrustedTypes(
+          "document.getElementById('sample').addEventListener('compositionend',"
+          "event => document.title = String(event.isTrusted));");
+      GetDocument().body()->AppendChild(script);
+      UpdateAllLifecyclePhasesForTest();
+      editable->Focus();
+      GetDocument().setTitle("no-compositionend");
+      Vector<ImeTextSpan> spans;
+      Controller().SetComposition("ni", spans, 2, 2);
+      if (mode == 0) {
+        Controller().CommitText("ni", spans, 0);
+      } else if (mode == 1) {
+        Controller().FinishComposingText(InputMethodController::kKeepSelection);
+      } else {
+        Controller().SetComposition(g_empty_string, spans, 0, 0);
+      }
+      EXPECT_EQ("true", GetDocument().title());
+    }
+  }
+}
